<script>
  // nav + hero parallax on scroll
  var nav = document.getElementById('nav');
  var glowLayer = document.querySelector('.glow-layer');
  var heroInner = document.querySelector('.hero-inner');
  var prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var ticking = false;
  function render(){
    var y = window.scrollY || window.pageYOffset || 0;
    if(y > 40){ nav.classList.add('scrolled'); } else { nav.classList.remove('scrolled'); }
    if(!prefersReduce && glowLayer && y < window.innerHeight){
      glowLayer.style.transform = 'translate3d(0,' + (y * 0.6) + 'px,0) scale(' + (1 + y * 0.00018) + ')';
      heroInner.style.transform = 'translate3d(0,' + (y * 0.26) + 'px,0)';
      heroInner.style.opacity = Math.max(0, 1 - y / 560);
    }
    ticking = false;
  }
  function onScroll(){ if(!ticking){ requestAnimationFrame(render); ticking = true; } }
  window.addEventListener('scroll', onScroll, {passive:true});
  render();

  // crystallize burst on press
  if(!prefersReduce){
    document.querySelectorAll('.glass-btn').forEach(function(btn){
      btn.addEventListener('pointerdown', function(e){
        var rect = btn.getBoundingClientRect();
        var x = (e.clientX || rect.left + rect.width/2) - rect.left;
        var y = (e.clientY || rect.top + rect.height/2) - rect.top;
        btn.style.setProperty('--fx', (x/rect.width*100) + '%');
        btn.style.setProperty('--fy', (y/rect.height*100) + '%');
        btn.classList.remove('crystallizing');
        void btn.offsetWidth;
        btn.classList.add('crystallizing');
        var burst = document.createElement('span');
        burst.className = 'crystal-burst';
        burst.style.left = x + 'px';
        burst.style.top = y + 'px';
        var n = 11;
        for(var i=0;i<n;i++){
          var s = document.createElement('span');
          s.className = 'shard';
          s.style.setProperty('--ang', ((360/n)*i + (Math.random()*22-11)) + 'deg');
          s.style.setProperty('--dist', (28 + Math.random()*22) + 'px');
          s.style.setProperty('--delay', Math.floor(Math.random()*50) + 'ms');
          burst.appendChild(s);
        }
        btn.appendChild(burst);
        setTimeout(function(){ btn.classList.remove('crystallizing'); }, 520);
        setTimeout(function(){ burst.remove(); }, 760);
      });
    });
  }

  // services accordion
  var toggles = document.querySelectorAll('.svc-toggle');
  toggles.forEach(function(btn){
    var panel = btn.nextElementSibling;
    btn.addEventListener('click', function(){
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      if(open){
        panel.style.maxHeight = panel.scrollHeight + 'px';
        requestAnimationFrame(function(){ panel.style.maxHeight = '0px'; });
      } else {
        panel.style.maxHeight = panel.scrollHeight + 'px';
        panel.addEventListener('transitionend', function te(){
          panel.style.maxHeight = 'none';
          panel.removeEventListener('transitionend', te);
        });
      }
    });
  });

  // scroll reveal
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var items = document.querySelectorAll('.reveal');
  if(reduce || !('IntersectionObserver' in window)){
    items.forEach(function(el){ el.classList.add('in'); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, {threshold:.14, rootMargin:'0px 0px -8% 0px'});
    items.forEach(function(el){ io.observe(el); });
  }
</script>
</body>
</html>
