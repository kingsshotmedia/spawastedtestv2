<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script>document.documentElement.classList.add('js');</script>
<link rel="icon" type="image/png" href="data:image/webp;base64," />
<title>Spa Wasted — Los Alamitos, CA</title>
<meta name="description" content="Spa Wasted is Carrie Wright's studio in Los Alamitos, CA. Diamond Tip Microdermabrasion, chemical and enzyme peels, dermaplaning, microcurrent, and acne facials. Walk out glowing." />

<meta property="og:title" content="Spa Wasted" />
<meta property="og:description" content="Facials that leave you glowing, dewy, and a little Spa Wasted. Los Alamitos, CA." />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://www.spawasted.com" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<style>
  :root{
    /* palette: cool hydration blues */
    --petal:#E9F1F6;
    --petal-deep:#D7E4EF;
    --ink:#132A3E;
    --ink-soft:#516A7D;
    --wine:#1C5D8C;
    --wine-deep:#124A72;
    --glow-a:#B4DCEC;
    --glow-b:#8FCBE4;
    --line:rgba(19,42,62,.14);
    --display:"Fraunces",Georgia,serif;
    --body:"Hanken Grotesk",-apple-system,BlinkMacSystemFont,sans-serif;
  }

  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
  body{
    background:var(--petal);
    color:var(--ink);
    font-family:var(--body);
    font-size:18px;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  ::selection{background:var(--wine);color:var(--petal)}

  a{color:inherit;text-decoration:none}
  img{max-width:100%;display:block}

  .wrap{width:100%;max-width:1180px;margin:0 auto;padding:0 26px}

  .eyebrow{
    font-family:var(--body);
    font-size:.72rem;
    font-weight:600;
    letter-spacing:.22em;
    text-transform:uppercase;
    color:var(--wine);
  }

  /* ---------- nav ---------- */
  header.nav{
    position:fixed;top:0;left:0;right:0;z-index:50;
    display:flex;align-items:center;justify-content:space-between;
    padding:20px 26px;
    transition:background .4s ease, padding .4s ease;
  }
  header.nav.scrolled{
    background:rgba(233,241,246,.86);
    backdrop-filter:blur(10px);
    padding:14px 26px;
    border-bottom:1px solid var(--line);
  }
  .brand{
    font-family:var(--display);
    font-weight:500;
    font-size:1.32rem;
    letter-spacing:-.01em;
  }
  .brand em{font-style:italic;color:var(--wine)}
  .nav-links{display:flex;gap:30px;align-items:center}
  .nav-links a{font-size:.82rem;font-weight:500;letter-spacing:.02em}
  .nav-links a.book{
    padding:9px 20px;border-radius:100px;
    transition:background .25s ease,border-color .25s ease,transform .25s ease;
  }
  .nav-links a.book:hover{transform:translateY(-1px)}
  .nav-links a:not(.book){opacity:.72;transition:opacity .2s,color .3s ease;color:var(--petal)}
  .nav-links a:not(.book):hover{opacity:1}
  header.nav.scrolled .nav-links a:not(.book){color:var(--ink)}
  header.nav:not(.scrolled) .nav-links a.book{color:var(--petal);background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.4)}
  @media(max-width:680px){ .nav-links a.text{display:none} }

  /* ---------- hero ---------- */
  .hero{
    position:relative;
    min-height:100svh;
    display:flex;flex-direction:column;justify-content:center;
    padding:120px 26px 60px;
    overflow:hidden;
    background:#000;
  }
  .glow-layer{
    position:absolute;inset:0;z-index:0;pointer-events:none;
    display:flex;align-items:center;justify-content:center;
    will-change:transform;
  }
  .glow{
    width:min(115vw,900px);height:min(115vw,900px);
    margin-top:-7vh;
    background:radial-gradient(circle at center,
        var(--glow-a) 0%, rgba(143,203,228,.45) 34%, rgba(233,241,246,0) 68%);
    animation:glowIn 1.7s cubic-bezier(.2,.7,.2,1) both, breathe 9s 1.7s ease-in-out infinite;
  }
  @keyframes glowIn{
    from{opacity:0;transform:scale(.15)}
    to{opacity:.9;transform:scale(1)}
  }
  @keyframes breathe{
    0%,100%{opacity:.85;transform:scale(1)}
    50%{opacity:1;transform:scale(1.08)}
  }
  .hero-inner{position:relative;z-index:2;max-width:1180px;margin:0 auto;width:100%;will-change:transform,opacity}
  .hero-tag{
    position:absolute;top:82px;left:0;right:0;z-index:3;
    text-align:center;padding:0 26px;
    font-size:.8rem;font-weight:600;letter-spacing:.04em;color:var(--glow-b);
    animation:heroRise .9s .25s both cubic-bezier(.2,.7,.2,1);
  }
  .hero .eyebrow{margin-bottom:22px;color:var(--glow-b);font-size:.9rem;font-weight:800;letter-spacing:.1em}
  .hero-located{
    margin-top:20px;
    font-family:var(--display);font-style:italic;font-weight:500;
    font-size:clamp(1.3rem,3.6vw,1.75rem);
    color:var(--glow-b);
    animation:heroRise .9s 1.05s both cubic-bezier(.2,.7,.2,1);
  }
  .hero-note{
    position:absolute;bottom:22px;left:0;right:0;z-index:2;
    text-align:center;padding:0 26px;
    font-size:.76rem;letter-spacing:.02em;color:rgba(233,241,246,.55);
    animation:heroRise .9s 1.4s both cubic-bezier(.2,.7,.2,1);
  }
  .hero-note a{color:rgba(233,241,246,.82);border-bottom:1px solid rgba(233,241,246,.3)}
  .hero-note a:hover{color:var(--glow-b);border-color:var(--glow-b)}

  /* load-in sequence */
  .hero .eyebrow{animation:heroRise .9s .4s both cubic-bezier(.2,.7,.2,1)}
  .wordmark{animation:heroWord 1.35s .55s both cubic-bezier(.16,.8,.24,1);will-change:transform,filter,opacity}
  .hero-sub{animation:heroRise .9s 1.05s both cubic-bezier(.2,.7,.2,1)}
  .hero-cta{animation:heroRise .9s 1.22s both cubic-bezier(.2,.7,.2,1)}
  @keyframes heroRise{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:none}}
  @keyframes heroWord{from{opacity:0;transform:translateY(50px) scale(.86);filter:blur(14px)}to{opacity:1;transform:none;filter:blur(0)}}

  .wordmark{
    font-family:var(--display);
    font-weight:300;
    font-size:clamp(3.6rem,16vw,11rem);
    line-height:.9;
    letter-spacing:-.03em;
  }
  .wordmark em{font-style:italic;font-weight:400;color:var(--wine)}
  .hero-sub{
    margin-top:30px;
    max-width:31ch;
    font-size:clamp(1.15rem,3.4vw,1.5rem);
    line-height:1.32;
    color:rgba(233,241,246,.82);
  }
  .hero-cta{
    margin-top:40px;
    display:inline-flex;align-items:center;gap:12px;
    padding:15px 30px;border-radius:100px;
    font-weight:600;font-size:.98rem;
    transition:background .25s ease,transform .25s ease,border-color .25s ease;
  }
  .hero-cta:hover{transform:translateY(-2px)}
  @media(min-width:768px){
    .hero-inner{text-align:center}
    .hero-logo{background-position:center}
  }
  .hero-cta span{transition:transform .25s ease}
  .hero-cta:hover span{transform:translateX(4px)}

  /* ---------- generic section ---------- */
  section{padding:clamp(80px,12vw,150px) 0}
  .lede{
    font-family:var(--display);
    font-weight:300;
    font-size:clamp(1.7rem,5vw,3.1rem);
    line-height:1.18;
    letter-spacing:-.02em;
    max-width:20ch;
  }
  .lede .accent{color:var(--wine);font-style:italic;font-weight:400}
  .statement{max-width:760px}
  .statement p{
    margin-top:28px;
    font-size:clamp(1.05rem,2.6vw,1.25rem);
    color:var(--ink-soft);
    max-width:56ch;
  }

  /* ---------- services ---------- */
  .services{background:var(--petal-deep)}
  .svc-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:56px}
  .svc-head h2{
    font-family:var(--display);font-weight:400;
    font-size:clamp(2rem,6vw,3.4rem);letter-spacing:-.02em;line-height:1;
  }
  .svc-head .eyebrow{align-self:flex-start}

  .svc-group{margin-bottom:52px}
  .svc-group:last-child{margin-bottom:0}
  .svc-group > .glabel{
    font-family:var(--body);font-size:.74rem;font-weight:600;
    letter-spacing:.2em;text-transform:uppercase;color:var(--ink-soft);
    padding-bottom:14px;border-bottom:1px solid var(--line);margin-bottom:6px;
  }
  .svc{border-bottom:1px solid var(--line)}
  .svc-toggle{
    width:100%;background:none;border:0;cursor:pointer;
    display:flex;align-items:center;justify-content:space-between;gap:18px;
    padding:24px 4px 24px 0;text-align:left;color:var(--ink);
    font-family:var(--display);font-weight:400;
    font-size:clamp(1.2rem,3.4vw,1.7rem);letter-spacing:-.01em;line-height:1.12;
    transition:color .2s ease;
  }
  .svc-toggle:hover{color:var(--wine)}
  .svc-name{display:flex;flex-direction:column;min-width:0}
  .svc-sub{font-family:var(--display);font-style:italic;font-weight:400;font-size:.9rem;color:var(--wine);margin-top:5px;line-height:1.2}
  .svc-meta{display:flex;align-items:center;gap:15px;flex:none}
  .svc-price{font-family:var(--body);font-size:.98rem;font-weight:600;color:var(--ink);white-space:nowrap}
  .svc-pricing{margin-top:16px;font-family:var(--body);font-size:.82rem;font-weight:600;letter-spacing:.03em;color:var(--ink-soft);border-top:1px solid var(--line);padding-top:12px}
  .glabel-intro{font-family:var(--body);color:var(--ink-soft);font-size:1rem;line-height:1.5;margin:2px 0 4px;max-width:58ch}
  .svc-icon{flex:none;width:24px;height:24px;position:relative;color:var(--wine)}
  .svc-icon::before,.svc-icon::after{
    content:"";position:absolute;top:50%;left:50%;background:currentColor;border-radius:2px;
  }
  .svc-icon::before{width:15px;height:2px;transform:translate(-50%,-50%)}
  .svc-icon::after{width:2px;height:15px;transform:translate(-50%,-50%);transition:transform .35s ease}
  .svc-toggle[aria-expanded="true"] .svc-icon::after{transform:translate(-50%,-50%) scaleY(0)}
  .svc-panel{max-height:0;overflow:hidden;transition:max-height .4s ease}
  .svc-panel-inner{padding:0 0 26px;max-width:60ch}
  .svc-panel-inner p{color:var(--ink-soft);font-size:1.02rem;line-height:1.5}

  /* ---------- about us ---------- */
  .au-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(28px,6vw,72px);align-items:start}
  @media(max-width:820px){ .au-grid{grid-template-columns:1fr;gap:22px} }
  .au-head .eyebrow{margin-bottom:18px}
  .au-title{
    font-family:var(--display);font-weight:300;
    font-size:clamp(2rem,6vw,3.3rem);letter-spacing:-.02em;line-height:1.05;
  }
  .au-title em{font-style:italic;color:var(--wine)}
  .au-body p{
    color:var(--ink-soft);font-size:clamp(1.05rem,2.6vw,1.2rem);line-height:1.55;
    margin-bottom:18px;max-width:54ch;
  }
  .au-body p:last-child{margin-bottom:0}

  /* ---------- about ---------- */
  .about-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(30px,6vw,80px);align-items:center}
  @media(max-width:820px){ .about-grid{grid-template-columns:1fr} }
  .portrait{
    aspect-ratio:4/5;border-radius:6px;overflow:hidden;position:relative;
    background-image:url("data:image/webp;base64,");
    background-size:cover;background-position:center 18%;
  }
  .portrait .ph{
    font-family:var(--body);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;
    color:var(--ink-soft);padding:16px;
  }
  .about-copy h2{
    font-family:var(--display);font-weight:400;
    font-size:clamp(1.9rem,5.5vw,3rem);letter-spacing:-.02em;line-height:1.05;margin-bottom:8px;
  }
  .about-copy .role{color:var(--wine);font-weight:600;font-size:.82rem;letter-spacing:.16em;text-transform:uppercase}
  .about-copy p{margin-top:24px;color:var(--ink-soft);max-width:48ch}

  /* ---------- visit ---------- */
  .visit{background:var(--ink);color:var(--petal)}
  .visit .eyebrow{color:var(--glow-b)}
  .visit h2{
    font-family:var(--display);font-weight:300;
    font-size:clamp(2.4rem,9vw,5.5rem);letter-spacing:-.02em;line-height:.95;margin:18px 0 50px;
  }
  .visit h2 em{font-style:italic;color:var(--glow-b)}
  .visit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:36px;margin-bottom:56px}
  @media(max-width:720px){ .visit-grid{grid-template-columns:1fr;gap:30px} }
  .vcard .k{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--glow-b);margin-bottom:12px}
  .vcard p,.vcard a{font-size:1.12rem;line-height:1.5;color:var(--petal)}
  .vcard a{border-bottom:1px solid rgba(233,241,246,.3);transition:border-color .2s}
  .vcard a:hover{border-color:var(--glow-b)}
  .visit-cta{
    display:inline-flex;align-items:center;gap:12px;
    padding:16px 34px;border-radius:100px;font-weight:600;
    transition:transform .25s ease,background .25s ease,border-color .25s ease;
  }
  .visit-cta:hover{transform:translateY(-2px)}

  /* ---------- footer ---------- */
  footer{background:var(--ink);color:var(--petal);padding:40px 26px 54px;border-top:1px solid rgba(233,241,246,.12)}
  .foot-in{max-width:1180px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-between;gap:20px;align-items:center}
  .foot-in .fbrand{font-family:var(--display);font-size:1.3rem}
  .foot-in .fbrand em{font-style:italic;color:var(--glow-b)}
  .foot-in .fmeta{font-size:.82rem;color:rgba(233,241,246,.6);line-height:1.6}
  .foot-toplink{max-width:1180px;margin:26px auto 0;display:flex;justify-content:center}
  .to-top{display:inline-flex;align-items:center;gap:8px;color:var(--petal);font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:11px 22px;border:1px solid rgba(233,241,246,.28);border-radius:100px;transition:background .25s ease,border-color .25s ease}
  .to-top:hover{background:rgba(233,241,246,.1);border-color:rgba(233,241,246,.6)}
  .to-top span{transition:transform .25s ease}
  .to-top:hover span{transform:translateY(-3px)}

  /* ---------- glass buttons + crystallize ---------- */
  .glass-btn{position:relative;overflow:visible;-webkit-tap-highlight-color:transparent}
  .glass-light{
    color:var(--ink);
    background:rgba(255,255,255,.5);
    border:1px solid rgba(255,255,255,.6);
    box-shadow:0 6px 20px rgba(19,42,62,.12), inset 0 1px 0 rgba(255,255,255,.65);
  }
  .glass-dark{
    color:var(--petal);
    background:rgba(255,255,255,.16);
    border:1px solid rgba(255,255,255,.3);
    box-shadow:0 8px 24px rgba(0,0,0,.3), inset 0 1px 0 rgba(255,255,255,.3);
  }
  @supports ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
    .glass-light{background:rgba(255,255,255,.18);-webkit-backdrop-filter:blur(15px) saturate(1.7);backdrop-filter:blur(15px) saturate(1.7)}
    .glass-dark{background:rgba(255,255,255,.1);-webkit-backdrop-filter:blur(15px) saturate(1.5);backdrop-filter:blur(15px) saturate(1.5)}
  }
  .glass-light:hover{background:rgba(255,255,255,.34);border-color:rgba(255,255,255,.85)}
  .glass-dark:hover{background:rgba(255,255,255,.2);border-color:rgba(255,255,255,.5)}

  .crystal-burst{position:absolute;width:0;height:0;pointer-events:none;z-index:6}
  .shard{
    position:absolute;left:0;top:0;width:7px;height:17px;margin:-8px 0 0 -3px;
    background:linear-gradient(180deg,rgba(255,255,255,.95),rgba(143,203,228,.45));
    clip-path:polygon(50% 0,100% 42%,50% 100%,0 42%);
    filter:drop-shadow(0 0 3px rgba(255,255,255,.55));
    opacity:0;transform:rotate(var(--ang)) translateY(0) scale(.2);
    animation:shardBurst .62s var(--delay,0ms) cubic-bezier(.15,.7,.2,1) forwards;
  }
  @keyframes shardBurst{
    0%{opacity:0;transform:rotate(var(--ang)) translateY(0) scale(.2)}
    28%{opacity:1}
    100%{opacity:0;transform:rotate(var(--ang)) translateY(calc(var(--dist,30px) * -1)) scale(1)}
  }
  .glass-btn.crystallizing::after{
    content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:5;
    background:radial-gradient(circle at var(--fx,50%) var(--fy,50%), rgba(255,255,255,.7), rgba(255,255,255,0) 68%);
    animation:frostFlash .5s ease-out forwards;
  }
  @keyframes frostFlash{from{opacity:.9}to{opacity:0}}

  /* ---------- reviews ---------- */
  .reviews .rev-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:44px}
  .reviews h2{font-family:var(--display);font-weight:400;font-size:clamp(2rem,6vw,3.4rem);letter-spacing:-.02em;line-height:1;margin-top:10px}
  .rev-badge{display:flex;align-items:center;gap:12px}
  .rev-rating{font-family:var(--display);font-weight:500;font-size:1.9rem;line-height:1;color:var(--ink)}
  .rev-badge .rev-stars{font-size:1.25rem}
  .rev-badge .rev-count{font-size:.82rem;color:var(--ink-soft);font-weight:600}
  .rev-stars{color:#F2A73B;letter-spacing:2px;line-height:1}
  .rev-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px}
  .rev-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:28px;box-shadow:0 8px 22px rgba(19,42,62,.05);display:flex;flex-direction:column}
  .rev-card .rev-stars{font-size:1rem;margin-bottom:14px}
  .rev-quote{font-size:1.02rem;line-height:1.55;color:var(--ink)}
  .rev-name{margin-top:18px;font-size:.76rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft)}
  .rev-photos{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:26px}
  @media(max-width:640px){ .rev-photos{grid-template-columns:repeat(2,1fr)} }
  .rev-photo{aspect-ratio:1/1;border-radius:12px;background:var(--petal-deep) center/cover no-repeat;overflow:hidden}
  .rev-cta{margin-top:34px}
  .yelp-btn{display:inline-flex;align-items:center;gap:10px;background:#d32323;color:#fff;padding:15px 28px;border-radius:100px;font-weight:600;font-size:.98rem;transition:background .25s ease,transform .25s ease}
  .yelp-btn:hover{background:#b31d1d;transform:translateY(-2px)}
  .yelp-btn .yelp-mark{font-family:var(--display);font-weight:600;font-style:italic}

  /* ---------- reveal ---------- */
  .js .reveal{opacity:0;transform:translateY(24px);transition:opacity .8s ease,transform .8s ease}
  .js .reveal.in{opacity:1;transform:none}

  @media(prefers-reduced-motion:reduce){
    *{animation:none!important}
    .js .reveal{opacity:1;transform:none;transition:none}
    .svc-panel,.svc-icon::after{transition:none}
    html{scroll-behavior:auto}
  }
  :focus-visible{outline:2px solid var(--wine);outline-offset:3px;border-radius:2px}
  .visit :focus-visible,footer :focus-visible{outline-color:var(--glow-b)}
  /* ---------- logo ---------- */
  .logo-img{background-image:url("data:image/webp;base64,");background-repeat:no-repeat;background-size:contain;background-position:left center;display:inline-block}
  .brand{display:flex;align-items:center}
  .brand-logo{width:112px;height:34px;transition:width .4s ease,height .4s ease}
  header.nav.scrolled .brand-logo{width:98px;height:30px}
  .hero-logo{width:min(82vw,600px);aspect-ratio:1000 / 314;height:auto}
  .foot-logo{width:124px;height:41px}
</style>
</head>
<body>

<header class="nav" id="nav">
  <a href="#top" class="brand" aria-label="Spa Wasted home"><span class="logo-img brand-logo"></span></a>
  <nav class="nav-links">
    <a href="#about" class="text">Carrie</a>
    <a href="#services" class="text">Services</a>
    <a href="#reviews" class="text">Reviews</a>
    <a href="#visit" class="text">Visit</a>
    <a href="https://wrightskincare.booksy.com" class="book glass-btn glass-light" target="_blank" rel="noopener">Book</a>
  </nav>
</header>

<main id="top">

  <!-- HERO -->
  <section class="hero">
    <div class="glow-layer" aria-hidden="true"><div class="glow"></div></div>
    <p class="hero-tag">New location, same great services!</p>
    <div class="hero-inner">
      <p class="eyebrow">10698 Los Alamitos Blvd, Los Alamitos, CA 90720</p>
      <h1 class="wordmark"><span class="logo-img hero-logo" role="img" aria-label="Spa Wasted"></span></h1>
